      "rawnode-events/AdvancedEventDispatcher.js": [
        "./types/dispatcher.d.ts"
      ],
      "rawnode-events/EventDispatcher.js": [
        "./types/legacy.d.ts"
      ],
      "rawnode-events/Event.js": [
        "./types/event.d.ts"
      ],
      "rawnode-events/EventName.js": [
        "./types/event-name.d.ts"
