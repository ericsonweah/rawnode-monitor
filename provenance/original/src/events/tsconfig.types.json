      ],
      "rawnode-events/durable": [
        "./types/durable.d.ts"
      ],
      "rawnode-events/durability": [
        "./types/durable.d.ts"
      ],
      "rawnode-events/queue": [
        "./types/queue.d.ts"
      ],
      "rawnode-events/workflows": [
        "./types/workflows.d.ts"
      ],
      "rawnode-events/sourcing": [
        "./types/sourcing.d.ts"
      ],
      "rawnode-events/testing": [
        "./types/testing.d.ts"
      ],
      "rawnode-events/contracts": [
        "./types/contracts.d.ts"
      ],
      "rawnode-events/observability": [
        "./types/observability.d.ts"
      ],
      "rawnode-events/serialization": [
        "./types/serialization.d.ts"
      ],
      "rawnode-events/provider": [
        "./types/provider.d.ts"
      ],
      "rawnode-events/console": [
        "./types/console.d.ts"
      ],
      "rawnode-events/config": [
        "./types/config.d.ts"
      ],
      "rawnode-events/dispatcher": [
