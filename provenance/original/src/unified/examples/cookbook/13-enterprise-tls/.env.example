NODE_ENV=production
APP_ENV=production
APP_KEY=replace_with_secret
UNIFIED_HOST=0.0.0.0
UNIFIED_PORT=3443
UNIFIED_TLS_KEY_PATH=./storage/certs/server.key
UNIFIED_TLS_CERT_PATH=./storage/certs/server.crt
UNIFIED_TLS_CA_PATH=./storage/certs/ca.crt
UNIFIED_TLS_SERVERNAME=api.example.com
UNIFIED_UDP_HANDSHAKE_SECRET=replace_with_shared_udp_cookie_secret
UNIFIED_UDP_ENCRYPTION=true
UNIFIED_UDP_ENCRYPTION_KEY=replace_with_udp_codec_key
