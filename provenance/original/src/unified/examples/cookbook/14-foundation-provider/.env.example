NODE_ENV=production
APP_ENV=production
APP_KEY=replace_with_secret_manager_value

UNIFIED_ENABLED=true
UNIFIED_REQUIRED=true
UNIFIED_AUTO_START=false
UNIFIED_PROFILE=enterprise
UNIFIED_FAIL_FAST=true
UNIFIED_STRICT_CONFIG=true
UNIFIED_BOOT_SUMMARY=true

UNIFIED_HOST=0.0.0.0
UNIFIED_PORT=3000
UNIFIED_HTTP=true
UNIFIED_WEBSOCKET=true
UNIFIED_TCP=true
UNIFIED_UDP=true
UNIFIED_AMBIGUOUS_PROTOCOL=reject

UNIFIED_REUSE_HTTP_RUNTIME=true
UNIFIED_REUSE_WS_RUNTIME=true
UNIFIED_REUSE_TCP_RUNTIME=true
UNIFIED_REUSE_UDP_RUNTIME=true
UNIFIED_REQUIRE_EXISTING_RUNTIMES=true
UNIFIED_REJECT_STANDALONE_LISTENERS=true
UNIFIED_ENFORCE_SAME_PORT=true
UNIFIED_ENFORCE_PROTOCOL_PROFILES=true
UNIFIED_CLOSE_EXTERNAL=false

# Exactly one transport owner. Lower-level providers must not bind listeners.
HTTP_SERVER_AUTO_START=false
HTTP_SERVER_HANDLE_SIGNALS=false
HTTP_ATTACH_WS=false
WS_AUTO_ATTACH_HTTP=false
TCP_AUTO_START=false
UDP_AUTO_LISTEN=false

UNIFIED_MANAGE_SIGNALS=true
UNIFIED_SIGNALS=SIGINT,SIGTERM
UNIFIED_SIGNAL_TIMEOUT_MS=30000
UNIFIED_SIGNAL_FORCE=true
UNIFIED_SIGNAL_SET_EXIT_CODE=true
UNIFIED_SIGNAL_EXIT=false

UNIFIED_READINESS=true
UNIFIED_READINESS_CRITICAL=true
UNIFIED_READINESS_REQUIRE_LISTENING=true
UNIFIED_LIVENESS=true
UNIFIED_METRICS=true
UNIFIED_DIAGNOSTICS=true
UNIFIED_DOCTOR_ON_BOOT=true
UNIFIED_UDP_HANDSHAKE_SECRET=replace_with_shared_udp_cookie_secret
