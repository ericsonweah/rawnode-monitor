diff --git a/package/test/readiness-http-delivery.test.mjs b/package/test/readiness-http-delivery.test.mjs
new file mode 100644
index 0000000..84d200a
--- /dev/null
+++ b/package/test/readiness-http-delivery.test.mjs
@@ -0,0 +1,137 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import { once } from 'node:events';
+import { HttpJsonExporter, SignalPipeline } from '../src/index.js';
+
+async function endpoint(handler) {
+  const server = http.createServer(handler);
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  return {
+    url: `http://127.0.0.1:${server.address().port}/telemetry`,
+    async close() {
+      server.closeAllConnections();
+      await new Promise(resolve => server.close(resolve));
+    },
+  };
+}
+
+test('HTTP acknowledgement timeout reports uncertain delivery without repeating the request', { timeout: 2_000 }, async () => {
+  let requests = 0;
+  const target = await endpoint(request => { requests++; request.resume(); });
+  const exporter = new HttpJsonExporter({ url: target.url, compression: false, timeoutMs: 100, maxAttempts: 3, retryBaseMs: 1, retryMaxMs: 1 });
+  try {
+    await assert.rejects(exporter.export([{ kind: 'event', id: 'received-without-ack' }]), error => {
+      assert.equal(error.code, 'MONITOR_EXPORT_TIMEOUT');
+      assert.equal(error.retryable, false);
+      assert.equal(error.details.delivery, 'unknown');
+      return true;
+    });
+    assert.equal(requests, 1);
+    assert.equal(exporter.stats.retries, 0);
+    assert.equal(exporter.stats.signals, 0);
+  } finally { await exporter.close(); await target.close(); }
+});
+
+test('a failed split export does not make the pipeline replay its acknowledged prefix', { timeout: 2_000 }, async () => {
+  const received = [];
+  const target = await endpoint(async (request, response) => {
+    let body = '';
+    for await (const chunk of request) body += chunk;
+    const id = JSON.parse(body).signals[0].id;
+    received.push(id);
+    response.writeHead(id === 'acknowledged' ? 200 : 503).end();
+  });
+  const exporter = new HttpJsonExporter({ url: target.url, compression: false, maxBatchSignals: 1, maxAttempts: 1 });
+  const pipeline = new SignalPipeline({ deliveryAttempts: 3, retryBaseMs: 1, retryMaxMs: 1, maxInFlightBatches: 1 });
+  pipeline.addSink('http', exporter, { required: true });
+  try {
+    pipeline.admit({ kind: 'event', id: 'acknowledged' });
+    pipeline.admit({ kind: 'event', id: 'unacknowledged' });
+    await assert.rejects(pipeline.flush({ throwOnError: true }), { code: 'MONITOR_PIPELINE_FLUSH_FAILED' });
+    assert.deepEqual(received, ['acknowledged', 'unacknowledged']);
+    assert.equal(pipeline.stats.sinkRetries, 0);
+    assert.equal(exporter.stats.signals, 1);
+    const failure = pipeline.snapshot().failures[0].error;
+    assert.equal(failure.retryable, false);
+    assert.equal(failure.details.acknowledgedSignals, 1);
+    assert.equal(failure.details.unacknowledgedSignals, 1);
+  } finally { await pipeline.close({ flush: false }); await target.close(); }
+});
+
+test('a truncated HTTP acknowledgement reports uncertainty without replaying accepted telemetry', { timeout: 2_000 }, async () => {
+  let requests = 0;
+  const target = await endpoint(async (request, response) => {
+    for await (const _chunk of request) { /* Accept the complete payload. */ }
+    requests++;
+    response.writeHead(200, { 'content-length': '100' });
+    response.write('partial', () => setImmediate(() => response.destroy()));
+  });
+  const exporter = new HttpJsonExporter({ url: target.url, compression: false, maxAttempts: 3, retryBaseMs: 1, retryMaxMs: 1 });
+  try {
+    await assert.rejects(exporter.export([{ kind: 'event', id: 'accepted-before-truncated-ack' }]), error => {
+      assert.equal(error.retryable, false);
+      assert.equal(error.details.delivery, 'unknown');
+      return true;
+    });
+    assert.equal(requests, 1);
+    assert.equal(exporter.stats.retries, 0);
+    assert.equal(exporter.stats.signals, 0);
+  } finally { await exporter.close(); await target.close(); }
+});
+
+test('a reset after sending the HTTP payload is not evidence that delivery failed', { timeout: 2_000 }, async () => {
+  let requests = 0;
+  const target = await endpoint(async request => {
+    for await (const _chunk of request) { /* Accept the complete payload. */ }
+    requests++;
+    request.socket.destroy();
+  });
+  const exporter = new HttpJsonExporter({ url: target.url, compression: false, maxAttempts: 3, retryBaseMs: 1, retryMaxMs: 1 });
+  try {
+    await assert.rejects(exporter.export([{ kind: 'event', id: 'accepted-before-reset' }]), error => {
+      assert.equal(error.code, 'ECONNRESET');
+      assert.equal(error.retryable, false);
+      assert.equal(error.details.delivery, 'unknown');
+      return true;
+    });
+    assert.equal(requests, 1);
+    assert.equal(exporter.stats.retries, 0);
+  } finally { await exporter.close(); await target.close(); }
+});
+
+test('HTTP timeout bounds the whole request even while acknowledgement bytes keep arriving', { timeout: 2_000 }, async () => {
+  let requests = 0;
+  let completedResponses = 0;
+  const target = await endpoint((request, response) => {
+    requests++;
+    request.resume();
+    response.writeHead(200);
+    response.write('start');
+    let chunks = 0;
+    const timer = setInterval(() => {
+      response.write('.');
+      if (++chunks === 20) {
+        clearInterval(timer);
+        completedResponses++;
+        response.end();
+      }
+    }, 20);
+    response.once('close', () => clearInterval(timer));
+  });
+  const exporter = new HttpJsonExporter({ url: target.url, compression: false, timeoutMs: 100, maxAttempts: 3, retryBaseMs: 1, retryMaxMs: 1 });
+  try {
+    await assert.rejects(exporter.export([{ kind: 'event', id: 'slow-acknowledgement' }]), error => {
+      assert.equal(error.code, 'MONITOR_EXPORT_TIMEOUT');
+      assert.equal(error.retryable, false);
+      assert.equal(error.details.delivery, 'unknown');
+      return true;
+    });
+    assert.equal(requests, 1);
+    assert.equal(completedResponses, 0);
+    assert.equal(exporter.stats.retries, 0);
+    assert.equal(exporter.stats.signals, 0);
+    assert.equal(exporter.pending.size, 0);
+  } finally { await exporter.close(); await target.close(); }
+});
diff --git a/package/test/studio-boundaries.test.mjs b/package/test/studio-boundaries.test.mjs
new file mode 100644
index 0000000..bb664ea
--- /dev/null
+++ b/package/test/studio-boundaries.test.mjs
@@ -0,0 +1,85 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import { MonitorRuntime, MonitorStudioManager, MonitorStudioController, MonitorStudioRateLimiter } from '../src/index.js';
+
+const request = { socket: { remoteAddress: '127.0.0.1' }, headers: { host: '127.0.0.1' }, params: { asset: 'studio.js' } };
+function response() {
+  const res = new EventEmitter();
+  res.headers = {};
+  res.setHeader = (name, value) => { res.headers[name] = value; };
+  res.writeHead = status => { res.statusCode = status; res.headersSent = true; };
+  res.write = () => true;
+  res.end = value => { res.body = value; };
+  return res;
+}
+
+test('Studio rate limiter bounds client keys for rejected and accepted admissions', () => {
+  const limiter = new MonitorStudioRateLimiter({ capacity: 1, maxKeys: 2 });
+  for (let index = 0; index < 20; index++) {
+    const result = limiter.consume(`rejected-${index}`, 5, 1000 + index);
+    assert.equal(result.ok, false);
+    assert.ok(result.retryAfterMs > 0);
+    assert.ok(limiter.snapshot().keys <= 2, 'Rejected clients obey the same key bound as accepted clients.');
+  }
+  assert.equal(limiter.snapshot().stats.rejected, 20);
+  assert.equal(limiter.snapshot().stats.evicted, 18);
+  assert.equal(limiter.consume('accepted', 1, 1020).ok, true);
+  assert.equal(limiter.consume('accepted', 1, 1021).ok, false);
+  assert.equal(limiter.snapshot().keys, 2);
+  assert.equal(limiter.consume('accepted', 1, 61_020).ok, true, 'Ordinary refill remains available.');
+});
+
+test('Studio non-JSON route failures use the same bounded redaction before response admission', async t => {
+  const monitor = new MonitorRuntime({ profile: 'test', logger: { warn() {}, error() {} } });
+  const studio = new MonitorStudioManager({ monitor });
+  t.after(async () => { await studio.close(); await monitor.close(); });
+  const details = { token: 'fixture-secret-details', value: 42n }; details.self = details;
+  const error = Object.assign(new Error('Bearer fixture-secret-message'), { code: 'MONITOR_FIXTURE_ROUTE', status: 503, details });
+  const fail = () => { throw error; };
+  const controller = new MonitorStudioController({ studio, assets: { read: async () => fail() } });
+  monitor.prometheus = fail;
+  studio.stream = fail;
+  const get = monitor.configuration.get.bind(monitor.configuration);
+  monitor.configuration.get = (key, fallback) => key === 'service' ? fail() : get(key, fallback);
+  for (const route of ['asset', 'prometheus', 'stream', 'page']) {
+    const res = response();
+    await controller[route](request, res);
+    assert.equal(res.statusCode, 503, route);
+    assert.match(res.headers['content-type'], /application\/json/);
+    assert.ok(Buffer.byteLength(res.body) < 4096);
+    assert.equal(res.body.includes('fixture-secret'), false);
+    const payload = JSON.parse(res.body);
+    assert.equal(payload.error.code, 'MONITOR_FIXTURE_ROUTE');
+    assert.equal(payload.error.details.value, '42');
+    assert.equal(payload.error.details.self, '[Circular]');
+    assert.equal(Object.hasOwn(payload.error, 'stack'), false);
+  }
+  const started = response();
+  studio.stream = (_req, res) => { res.writeHead(200); throw error; };
+  await assert.rejects(controller.stream(request, started), candidate => candidate === error);
+  assert.equal(started.body, undefined, 'A response already started is left to its transport owner, without a second JSON response.');
+});
+
+test('Studio stream capacity and close reject with a safe response and preserve owned client cleanup', async t => {
+  const monitor = new MonitorRuntime({ profile: 'test', logger: { warn() {}, error() {} } });
+  const studio = new MonitorStudioManager({ monitor, config: { maxClients: 1 } });
+  t.after(async () => { await studio.close(); await monitor.close(); });
+  const controller = new MonitorStudioController({ studio });
+  const admitted = response();
+  await controller.stream(request, admitted);
+  assert.equal(admitted.statusCode, 200);
+  assert.equal(studio.clients.size, 1);
+  const rejected = response();
+  await controller.stream(request, rejected);
+  assert.equal(rejected.statusCode, 503);
