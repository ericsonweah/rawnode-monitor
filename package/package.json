      "types": "./types/query.d.ts",
      "import": "./src/query/index.js"
    },
    "./incidents": {
      "types": "./types/incidents.d.ts",
      "import": "./src/incidents/index.js"
    },
    "./deployments": {
      "types": "./types/deployments.d.ts",
      "import": "./src/deployments/index.js"
