      "import": "./src/tracing/index.js"
    },
    "./cluster": {
      "types": "./types/cluster.d.ts",
      "import": "./src/cluster/index.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "import": "./src/core/index.js"
    },
    "./analysis": {
      "types": "./types/analysis.d.ts",
      "import": "./src/analysis/index.js"
