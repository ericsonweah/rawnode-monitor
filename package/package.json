  "files": [
    "src",
    "types",
    "config",
    "resources",
    "docs",
    "examples",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "test"
  ],
  "scripts": {
    "build": "node scripts/check.mjs",
    "test": "node --test --test-timeout=20000 test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "prepack": "node scripts/check.mjs",
    "prepublishOnly": "node scripts/reject-publication.mjs"
  }
