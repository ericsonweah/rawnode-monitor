    },
    "./health": {
      "types": "./types/health.d.ts",
      "import": "./src/health/index.js"
    },
    "./resources": {
      "types": "./types/resources.d.ts",
      "import": "./src/resources/index.js"
    },
    "./storage": {
      "types": "./types/storage.d.ts",
      "import": "./src/storage/index.js"
    },
    "./alerts": {
      "types": "./types/alerts.d.ts",
      "import": "./src/alerts/index.js"
    },
    "./integrations": {
      "types": "./types/integrations.d.ts",
